# ── Database (Neon PostgreSQL) ──────────────────────────
# DATABASE_URL: 带 -pool 的连接串（应用运行时用，走 PgBouncer）
# DIRECT_URL:   不带 -pool 的连接串（Prisma Migrate 用）
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/propack?sslmode=require"
DIRECT_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/propack?sslmode=require"

# ── Auth.js (NextAuth v5) ───────────────────────────────
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Apple Sign-In
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_PRIVATE_KEY=""

# Email magic link (Resend)
RESEND_API_KEY=""
EMAIL_FROM="no-reply@propackcustom.com"

# ── 人工对接流程（订单确认 / 付款链接）────────────────────
# 站点对外地址：邮件里的订单链接、付款回跳都基于它（末尾不要带 /）
SITE_URL="https://propackcustom-com.vercel.app"
# 新订单内部提醒收件人，多个用逗号分隔；留空则不发内部提醒
ADMIN_NOTIFY_EMAIL=""
# 客户咨询 / 发送付款凭证的邮箱（订单页与邮件中展示）
SALES_EMAIL="sales@propackcustom.com"
# 客户可见的业务邮箱（Design Studio 的“免费设计”卡片会把它作为第二入口显示）。
# 必须是可以真人收信的地址：不设、或设成 no-reply@ 类地址，卡片会自动隐藏邮箱入口、只保留报价表单。
# 与上面 SALES_EMAIL 的区别：那个是服务端外发/收款说明用的（可以是 no-reply），这个是公开给客户的。
NEXT_PUBLIC_SALES_EMAIL=""
# 提交后锁价时长（小时）；超期未确认，订单被打开时自动置为 EXPIRED
PRICE_LOCK_HOURS="72"

# 银行转账（T/T）收款信息。四项必填项缺任意一个，
# 订单页就只显示「稍后邮件发送银行信息」，避免占位符导致客户打错款。
TT_BANK_NAME=""
TT_ACCOUNT_NAME=""
TT_ACCOUNT_NUMBER=""
TT_SWIFT=""
TT_BANK_ADDRESS=""
TT_NOTES=""

# ── Stripe（付款链接）───────────────────────────────────
# 仅用 STRIPE_SECRET_KEY 创建 Payment Link，不接收银台、不接 webhook。
# 未配置或创建失败时，后台「确认订单」会自动降级为站内订单页 + 银行转账。
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"

# ── Cloudflare R2 (素材存储) ────────────────────────────
# 文件由浏览器预签名直传，不经过 Vercel（Serverless 请求体上限 4.5MB）。
# 必须在桶上配置 CORS，否则直传失败（前端会降级为「只记文件名」）：
#   AllowedOrigin: 你的站点域名（含 https://）
#   AllowedMethod: PUT
#   AllowedHeader: Content-Type
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="propack-artworks"
# 公共访问域名（配了才能直接给出文件 URL）；留空则后台用预签名 GET 临时查看
R2_PUBLIC_URL=""

# ── Upstash Redis (缓存/会话/限流) ─────────────────────
# /api/upload 用它做 IP 级限流（每小时 20 次预签名）；未配置则不限流
UPSTASH_REDIS_URL=""
UPSTASH_REDIS_TOKEN=""

# ── 二期：国内登录（微信 / QQ，需境内备案应用）──────────
# WECHAT_APPID=""
# WECHAT_SECRET=""
# QQ_APPID=""
# QQ_SECRET=""
