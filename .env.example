# ── Database (Neon PostgreSQL) ──────────────────────────
# DATABASE_URL: 带 -pool 的连接串（应用运行时用，走 PgBouncer）
# DIRECT_URL:   不带 -pool 的连接串（Prisma Migrate 用）
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/propack?sslmode=require"
DIRECT_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/propack?sslmode=require"

# ── Auth.js (NextAuth v5) ───────────────────────────────
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Apple Sign-In
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_PRIVATE_KEY=""

# Email magic link (Resend)
RESEND_API_KEY=""
EMAIL_FROM="no-reply@propackcustom.com"

# ── Stripe (全球支付) ───────────────────────────────────
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"

# ── Cloudflare R2 (素材存储) ────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="propack-artworks"
R2_PUBLIC_URL=""

# ── Upstash Redis (缓存/会话/限流) ─────────────────────
UPSTASH_REDIS_URL=""
UPSTASH_REDIS_TOKEN=""

# ── 二期：国内登录（微信 / QQ，需境内备案应用）──────────
# WECHAT_APPID=""
# WECHAT_SECRET=""
# QQ_APPID=""
# QQ_SECRET=""
