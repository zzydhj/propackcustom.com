// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Auth.js 用户与多提供商账号 ─────────────────
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  locale        String    @default("en") // 界面语言
  currency      String    @default("USD") // 偏好币种
  country       String?
  role          Role      @default(CUSTOMER)
  balance       Decimal   @default(0) @db.Decimal(10, 2) // 预充值信用余额
  createdAt     DateTime  @default(now())
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  addresses     Address[]
  artworks      Artwork[]
  quotes        Quote[]
  transactions  WalletTransaction[]
}

// ── 钱包 / 预充值信用流水 ─────────────────────
enum TxnType {
  TOPUP // 充值（管理员/系统入账）
  CHARGE // 扣款（下单/成交结算）
  REFUND // 退款
  ADJUSTMENT // 人工调整（可正可负）
}

model WalletTransaction {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         TxnType
  amount       Decimal       @db.Decimal(10, 2) // 有符号：入账为正、扣款为负
  balanceAfter Decimal       @db.Decimal(10, 2) // 本次变动后的余额快照
  currency     String        @default("USD")
  reference    String? // 关联 orderId / quoteId 等
  note         String?
  createdAt    DateTime      @default(now())

  @@index([userId, createdAt])
}

enum Role {
  CUSTOMER
  WHOLESALE // 批发 / B2B
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String // oauth / email
  provider          String // google / apple / wechat / qq / resend
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  scope             String?
  id_token          String? @db.Text
  token_type        String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── 商品目录 ────────────────────────────────
model Category {
  id       String     @id @default(cuid())
  slug     String     @unique
  name     Json // 多语言 { "en": "...", "zh": "..." }
  parentId String?
  parent   Category?  @relation("cat", fields: [parentId], references: [id])
  children Category[] @relation("cat")
  products Product[]
}

model Product {
  id            String      @id @default(cuid())
  slug          String      @unique
  categoryId    String
  category      Category    @relation(fields: [categoryId], references: [id])
  name          Json // 多语言
  description   Json // 多语言
  images        String[]
  basePrice     Decimal     @db.Decimal(10, 2)
  currency      String      @default("USD")
  pricingMode   PricingMode @default(FIXED) // FIXED=基础价+选项；AREA=按长×宽面积计价
  pricePerSqm   Decimal?    @db.Decimal(10, 2) // AREA 模式：每平方米单价
  quantityTiers Json? // 数量阶梯 [{ min, discountPct }]
  specs         Spec[] // 材质/尺寸/工艺等可选项（旧，保留）
  quotes        Quote[]
  orderItems    OrderItem[]
  attributeGroups AttributeGroup[]
  dependencyRules DependencyRule[]
  priceRules    PriceRule[] // 计价层：独立附加费/一次性费用规则
  active        Boolean     @default(true)
}

enum PricingMode {
  FIXED
  AREA
}

model Spec {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      Json // "Material" / "Size"
  options   Json // ["Kraft","Corrugated",...] 含加价
}

// ── 属性联动规则引擎（归一化三层）──────────
model AttributeGroup {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name           String
  selectType     String   @default("single") // single|multi|number|text|dimension|file
  displayType    String   @default("button") // button|radio|checkbox|dropdown
  unit           String?
  isRequired     Boolean  @default(false)
  sort           Int      @default(0)
  min            Float?
  max            Float?
  parentOptionId String? // 结构层：仅当该父选项被选中时渲染本组
  options        AttributeOption[]
  rulesTargeting DependencyRule[] @relation("TargetGroup")

  @@index([productId])
}

model AttributeOption {
  id               String   @id @default(cuid())
  groupId          String
  group            AttributeGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name             String
  parentOptionId   String? // 结构层：选项级父子（预留）
  defaultState     String   @default("enabled") // enabled|disabled|hidden
  isDefaultChecked Boolean  @default(false)
  sort             Int      @default(0)
  priceAdjustType  String   @default("FIXED") // FIXED|PERCENT（计价层；独立 price_rule 表下一期）
  priceAdjust      Decimal  @default(0) @db.Decimal(10, 2)
  rulesAsSource    DependencyRule[] @relation("SourceOption")

  @@index([groupId])
}

// ── 计价层：独立 price_rule（与「能不能选」的 DependencyRule 解耦）──
model PriceRule {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String // 费用名称（如 刀版费 / 制版费）
  optionId   String? // 软引用 AttributeOption.id；null=无条件（产品级），否则仅当该选项被选中且可选时计费
  chargeType String   @default("ONE_TIME") // ONE_TIME 一次性 | PER_UNIT ×数量 | PER_AREA ×面积×数量 | PERCENT 货值百分比
  priceValue Decimal  @default(0) @db.Decimal(10, 2)
  sort       Int      @default(0)

  @@index([productId])
}

model DependencyRule {
  id                    String   @id @default(cuid())
  productId             String
  product               Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sourceOptionId        String
  sourceOption          AttributeOption @relation("SourceOption", fields: [sourceOptionId], references: [id], onDelete: Cascade)
  targetGroupId         String
  targetGroup           AttributeGroup @relation("TargetGroup", fields: [targetGroupId], references: [id], onDelete: Cascade)
  allowedOptionIds      Json     @default("[]") // string[] 白名单（空=不限制）
  disabledOptionIds     Json     @default("[]") // string[] 黑名单
  hiddenOptionIds       Json     @default("[]") // string[] 隐藏
  forcedCheckedOptionId String? // 自动勾选项
  priority              Int      @default(0)

  @@index([productId, sourceOptionId])
}

// ── 报价 / RFQ（印刷跨境核心：先询价后下单）────
model Quote {
  id          String      @id @default(cuid())
  userId      String? // 允许匿名 RFQ
  user        User?       @relation(fields: [userId], references: [id])
  productId   String? // 未选具体 SKU 时按产品线询价
  product     Product?    @relation(fields: [productId], references: [id])
  productName String? // 报价的产品线/名称（原创字段）
  contactName String? // 联系人（原创字段）
  email       String? // 联系邮箱（原创字段）
  country     String? // 目的国（原创字段）
  quantity    Int
  detail      Json // 所选规格快照
  notes       String? // 备注（原创字段）
  artworkId   String?
  designId    String? // 软引用 UserDesign.id：客户在线设计作品
  status      QuoteStatus @default(PENDING)
  quotedPrice Decimal?    @db.Decimal(10, 2)
  currency    String      @default("USD")
  createdAt   DateTime    @default(now())
  orderId     String? // 软引用 Order.id：报价确认后转订单，避免询价黑洞

  @@index([email]) // 登录时按邮箱认领匿名询价
}

enum QuoteStatus {
  PENDING
  QUOTED
  ACCEPTED
  EXPIRED
}

// ── 素材文件（R2）──────────────────────────
model Artwork {
  id        String   @id @default(cuid())
  userId    String? // 匿名提交订单时也可上传素材
  user      User?    @relation(fields: [userId], references: [id])
  fileName  String
  r2Key     String   @unique // R2 对象键
  size      Int
  mime      String
  createdAt DateTime @default(now())
}

// ── 订单 ───────────────────────────────────
// 人工对接流程：SUBMITTED（客户提交，无需付款）→ 销售核对工艺/运费后改价
// → AWAITING_PAYMENT（已发付款链接）→ PAID → IN_PRODUCTION → SHIPPED → COMPLETED
model Order {
  id            String      @id @default(cuid())
  orderNo       String      @unique
  viewToken     String      @unique @default(cuid()) // 免登录访问 /order/[token] 的凭证
  userId        String? // 允许匿名提交（不注册也能下单，走人工对接）
  user          User?       @relation(fields: [userId], references: [id])
  contactName   String? // 匿名联系人
  email         String? // 联系邮箱：确认函与付款链接发往此处
  status        OrderStatus @default(SUBMITTED)
  currency      String      @default("USD")
  subtotal      Decimal     @db.Decimal(10, 2)
  shippingFee   Decimal     @db.Decimal(10, 2) @default(0)
  tax           Decimal     @db.Decimal(10, 2) @default(0)
  total         Decimal     @db.Decimal(10, 2)
  quotedTotal   Decimal?    @db.Decimal(10, 2) // 提交时配置器算出的总价（调价留痕基准）
  adjustReason  String? // 人工调价说明（运费 / 刀版费 / 汇率…）
  paymentMethod String? // stripe_link | manual_tt | wallet
  payUrl        String? // 付款链接（Stripe Payment Link 或本站 /order/[token]）
  proofFileName String? // 客户上传的付款凭证文件名
  proofUrl      String? // 凭证访问地址（配了 R2_PUBLIC_URL 时为公开直链）
  proofKey      String? // 凭证的 R2 对象键：私有桶下后台靠它按需预签名读取
  artworkId     String? // 软引用 Artwork.id
  designId      String? // 软引用 UserDesign.id：客户在线设计的可回改作品
  expiresAt     DateTime? // 报价有效期：SUBMITTED 超期未确认自动 EXPIRED
  confirmedAt   DateTime? // 人工确认时间
  paidAt        DateTime?
  addressId     String? // 匿名订单不建 Address，改存 shipping 快照
  address       Address?    @relation(fields: [addressId], references: [id])
  shipping      Json? // 收货信息快照 { recipient, phone, country, ... }
  items         OrderItem[]
  payment       Payment?
  trackingNo    String? // 国际物流单号
  carrier       String? // DHL/FedEx/UPS
  createdAt     DateTime    @default(now())

  @@index([status, createdAt])
  @@index([email]) // 登录时按邮箱认领匿名订单
}

enum OrderStatus {
  SUBMITTED // 已提交，待人工确认可行性与总价
  AWAITING_PAYMENT // 已确认并发送付款链接，等待客户付款
  PENDING_PAYMENT // 兼容旧数据：余额待扣款
  PAID
  IN_PRODUCTION
  SHIPPED
  COMPLETED
  CANCELLED
  EXPIRED // 报价超期未确认
}

// 内容发布状态（blog / video 共用）
enum PublishStatus {
  DRAFT
  PUBLISHED
}

// 博客文章：深度专业内容，SEO 主载体。body 存 Markdown
model Post {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  excerpt        String?
  body           String // Markdown 正文
  coverImage     String?
  tags           String[]
  author         String?
  seoTitle       String?
  seoDescription String?
  status         PublishStatus @default(DRAFT)
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, publishedAt])
}

// 视频模块：embed（YouTube/Vimeo）或自托管；transcript 文字稿利于 SEO
model Video {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  description    String?
  provider       String // youtube | vimeo | self
  embedId        String? // YouTube/Vimeo 视频 ID
  videoUrl       String? // 自托管 / R2 直链
  coverImage     String?
  durationSec    Int?
  transcript     String?
  seoTitle       String?
  seoDescription String?
  status         PublishStatus @default(DRAFT)
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, publishedAt])
}

// ── 在线包装设计系统（Design Studio）──

// 设计模板：刀版/出血参考层 + Fabric 预置场景
enum DesignStatus {
  DRAFT
  SUBMITTED
}

model DesignTemplate {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  productType   String // /design/[productType] 归类
  category      String?
  dielineSvg    String? // 刀版/折线/出血参考层（SVG）
  widthMm       Float?
  heightMm      Float?
  bleedMm       Float    @default(3)
  safeAreaMm    Float    @default(3)
  sceneTemplate Json? // Fabric JSON 预置内容
  previewImage  String?
  active        Boolean  @default(true)
  sort          Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([productType, active])
}

// 用户设计作品：sceneJson 存 Fabric 序列化；导出成品落 R2（exportKey）
model UserDesign {
  id         String       @id @default(cuid())
  userId     String? // 软引用：登录按邮箱认领匿名作品
  email      String?
  templateId String? // 软引用 DesignTemplate.id
  name       String       @default("Untitled design")
  sceneJson  Json // Fabric 画布序列化
  exportKey  String? // R2 导出成品对象键（PDF/PNG）
  thumbKey   String? // R2 缩略图键
  status     DesignStatus @default(DRAFT)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([userId])
  @@index([email])
  @@index([status, updatedAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  specs     Json
}

model Address {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id])
  country    String
  province   String? // State
  city       String?
  line1      String
  line2      String?
  postalCode String
  recipient  String
  phone      String
  isDefault  Boolean @default(false)
  orders     Order[]
}

model Payment {
  id        String   @id @default(cuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id])
  provider  String // stripe / paypal
  intentId  String   @unique // Stripe PaymentIntent id
  amount    Decimal  @db.Decimal(10, 2)
  currency  String
  status    String // succeeded / refunded
  createdAt DateTime @default(now())
}
