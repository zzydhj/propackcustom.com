// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Auth.js 用户与多提供商账号 ─────────────────
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  locale        String    @default("en") // 界面语言
  currency      String    @default("USD") // 偏好币种
  country       String?
  role          Role      @default(CUSTOMER)
  balance       Decimal   @default(0) @db.Decimal(10, 2) // 预充值信用余额
  createdAt     DateTime  @default(now())
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  addresses     Address[]
  artworks      Artwork[]
  quotes        Quote[]
  transactions  WalletTransaction[]
}

// ── 钱包 / 预充值信用流水 ─────────────────────
enum TxnType {
  TOPUP // 充值（管理员/系统入账）
  CHARGE // 扣款（下单/成交结算）
  REFUND // 退款
  ADJUSTMENT // 人工调整（可正可负）
}

model WalletTransaction {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         TxnType
  amount       Decimal       @db.Decimal(10, 2) // 有符号：入账为正、扣款为负
  balanceAfter Decimal       @db.Decimal(10, 2) // 本次变动后的余额快照
  currency     String        @default("USD")
  reference    String? // 关联 orderId / quoteId 等
  note         String?
  createdAt    DateTime      @default(now())

  @@index([userId, createdAt])
}

enum Role {
  CUSTOMER
  WHOLESALE // 批发 / B2B
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String // oauth / email
  provider          String // google / apple / wechat / qq / resend
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  scope             String?
  id_token          String? @db.Text
  token_type        String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── 商品目录 ────────────────────────────────
model Category {
  id       String     @id @default(cuid())
  slug     String     @unique
  name     Json // 多语言 { "en": "...", "zh": "..." }
  parentId String?
  parent   Category?  @relation("cat", fields: [parentId], references: [id])
  children Category[] @relation("cat")
  products Product[]
}

model Product {
  id            String      @id @default(cuid())
  slug          String      @unique
  categoryId    String
  category      Category    @relation(fields: [categoryId], references: [id])
  name          Json // 多语言
  description   Json // 多语言
  images        String[]
  basePrice     Decimal     @db.Decimal(10, 2)
  currency      String      @default("USD")
  pricingMode   PricingMode @default(FIXED) // FIXED=基础价+选项；AREA=按长×宽面积计价
  pricePerSqm   Decimal?    @db.Decimal(10, 2) // AREA 模式：每平方米单价
  attributes    Json? // 配置器字段定义（类型/选项/加价）
  quantityTiers Json? // 数量阶梯 [{ min, discountPct }]
  specs         Spec[] // 材质/尺寸/工艺等可选项（旧，保留）
  quotes        Quote[]
  orderItems    OrderItem[]
  active        Boolean     @default(true)
}

enum PricingMode {
  FIXED
  AREA
}

model Spec {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      Json // "Material" / "Size"
  options   Json // ["Kraft","Corrugated",...] 含加价
}

// ── 报价 / RFQ（印刷跨境核心：先询价后下单）────
model Quote {
  id          String      @id @default(cuid())
  userId      String? // 允许匿名 RFQ
  user        User?       @relation(fields: [userId], references: [id])
  productId   String? // 未选具体 SKU 时按产品线询价
  product     Product?    @relation(fields: [productId], references: [id])
  productName String? // 报价的产品线/名称（原创字段）
  contactName String? // 联系人（原创字段）
  email       String? // 联系邮箱（原创字段）
  country     String? // 目的国（原创字段）
  quantity    Int
  detail      Json // 所选规格快照
  notes       String? // 备注（原创字段）
  artworkId   String?
  status      QuoteStatus @default(PENDING)
  quotedPrice Decimal?    @db.Decimal(10, 2)
  currency    String      @default("USD")
  createdAt   DateTime    @default(now())
}

enum QuoteStatus {
  PENDING
  QUOTED
  ACCEPTED
  EXPIRED
}

// ── 素材文件（R2）──────────────────────────
model Artwork {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  fileName  String
  r2Key     String   @unique // R2 对象键
  size      Int
  mime      String
  createdAt DateTime @default(now())
}

// ── 订单 ───────────────────────────────────
model Order {
  id          String      @id @default(cuid())
  orderNo     String      @unique
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  status      OrderStatus @default(PENDING_PAYMENT)
  currency    String      @default("USD")
  subtotal    Decimal     @db.Decimal(10, 2)
  shippingFee Decimal     @db.Decimal(10, 2) @default(0)
  tax         Decimal     @db.Decimal(10, 2) @default(0)
  total       Decimal     @db.Decimal(10, 2)
  addressId   String
  address     Address     @relation(fields: [addressId], references: [id])
  items       OrderItem[]
  payment     Payment?
  trackingNo  String? // 国际物流单号
  carrier     String? // DHL/FedEx/UPS
  createdAt   DateTime    @default(now())
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  IN_PRODUCTION
  SHIPPED
  COMPLETED
  CANCELLED
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  specs     Json
}

model Address {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id])
  country    String
  province   String? // State
  city       String?
  line1      String
  line2      String?
  postalCode String
  recipient  String
  phone      String
  isDefault  Boolean @default(false)
  orders     Order[]
}

model Payment {
  id        String   @id @default(cuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id])
  provider  String // stripe / paypal
  intentId  String   @unique // Stripe PaymentIntent id
  amount    Decimal  @db.Decimal(10, 2)
  currency  String
  status    String // succeeded / refunded
  createdAt DateTime @default(now())
}
